# TheSwiftKit AI Backend — Environment Variables
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# ---- Provider ----
# Which LLM powers the AI endpoints: "openai" (default) or "gemini".
# The iOS app does not change — only this server does.
LLM_PROVIDER=openai

# ---- OpenAI (required when LLM_PROVIDER=openai) ----
OPENAI_API_KEY=your_openai_key_here

# ---- Gemini (required when LLM_PROVIDER=gemini) ----
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_key_here

# ---- Optional ----
PORT=5001
FLASK_DEBUG=true

# Override default OpenAI models (uncomment to customize)
# OPENAI_CHAT_MODEL=gpt-4o
# OPENAI_IMAGE_MODEL=gpt-image-1.5
# OPENAI_VISION_MODEL=gpt-4o

# Override OpenAI base URL (for proxies or Azure OpenAI)
# OPENAI_BASE_URL=https://your-proxy.example.com/v1

# Override default Gemini models (uncomment to customize)
# GEMINI_CHAT_MODEL=gemini-2.5-flash
# GEMINI_IMAGE_MODEL=imagen-3.0-generate-002
# GEMINI_VISION_MODEL=gemini-2.5-flash
